# AI Completion Gateway (server-side only)
# Used by Vercel serverless functions (api/*) and the local Vite dev middleware.
# The client bundle NEVER receives this key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google OAuth 2.0 Client ID for "Sign in with Google"
# Used both by the client for the sign-in button and verified server-side
# for both /api/openrouter and /api/fetch-url endpoints.
# Create one at Google Cloud Console → APIs & Services → Credentials →
# "Create credentials" → OAuth client ID → "Web application".
# Add your app origins to "Authorized JavaScript origins":
#   - http://localhost:3000   (local dev)
#   - https://your-vercel-domain (production)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# Optional: explicitly set server-side Google Client ID if different from VITE_ prefix
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional: Durable cross-instance rate limiting (Upstash Redis / Vercel KV)
# When not set, an in-memory sliding window limiter operates automatically.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
