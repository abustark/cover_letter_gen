# Used by the local dev server (see vite.config.ts). For production,
# set OPENROUTER_API_KEY as a Vercel environment variable instead —
# it lives server-side in api/* functions and is never bundled.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Public Google OAuth Client ID for "Sign in with Google" (mandatory to
# generate cover letters). Client IDs are public by design and safe to ship.
# Create one at Google Cloud Console → APIs & Services → Credentials →
# "Create credentials" → OAuth client ID → "Web application". Then add your
# app origins to "Authorized JavaScript origins":
#   - http://localhost:3000   (local dev)
#   - https://your-vercel-domain (production)
# For production, also add VITE_GOOGLE_CLIENT_ID as a Vercel env variable.
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
